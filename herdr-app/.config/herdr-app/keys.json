{
  "global": {
    "ctrl-space ctrl-space": "send:\u0000",

    "ctrl-space ?": "app.help",
    "ctrl-space shift-/": "app.help",
    "ctrl-space :": "app.palette",
    "ctrl-space shift-;": "app.palette",
    "ctrl-space s": "mod.open:picker",
    "ctrl-space b": "layout.toggle:sidebar",
    "ctrl-space tab": "agent.next",
    "ctrl-space shift-tab": "agent.prev",
    "ctrl-space =": "app.zoom_in",
    "ctrl-space -": "app.zoom_out",
    "ctrl-space 0": "app.zoom_reset",

    "alt-enter": "pane.split:down",
    "alt-shift-enter": "pane.split:right",
    "alt-escape": "pane.close",
    "ctrl-space h": "pane.split:down",
    "ctrl-space v": "pane.split:right",
    "ctrl-space x": "pane.close",
    "ctrl-space z": "pane.zoom",

    "ctrl-alt-h": "pane.go:left",
    "ctrl-alt-j": "pane.go:down",
    "ctrl-alt-k": "pane.go:up",
    "ctrl-alt-l": "pane.go:right",
