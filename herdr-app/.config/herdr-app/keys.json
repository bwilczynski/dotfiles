    "ctrl-alt-shift-k": "pane.swap:up",
    "ctrl-alt-shift-l": "pane.swap:right",

    "ctrl-space c": "tab.new",
    "ctrl-space r": "tab.rename",
    "ctrl-space k": "tab.close",
    "ctrl-space p": "tab.prev",
    "ctrl-space n": "tab.next",
    "ctrl-space 1": "tab.select:1",
    "ctrl-space 2": "tab.select:2",
    "ctrl-space 3": "tab.select:3",
    "ctrl-space 4": "tab.select:4",
    "ctrl-space 5": "tab.select:5",
    "ctrl-space 6": "tab.select:6",
    "ctrl-space 7": "tab.select:7",
    "ctrl-space 8": "tab.select:8",
    "ctrl-space 9": "tab.select:9",
    "alt-1": "tab.select:1",
    "alt-2": "tab.select:2",
    "alt-3": "tab.select:3",
    "alt-4": "tab.select:4",
    "alt-5": "tab.select:5",
    "alt-6": "tab.select:6",
    "alt-7": "tab.select:7",
    "alt-8": "tab.select:8",
    "alt-9": "tab.select:9",

    "ctrl-space shift-c": "space.new",
    "ctrl-space shift-r": "space.rename",
    "ctrl-space shift-k": "space.close",
    "ctrl-space shift-p": "space.prev",
    "ctrl-space shift-n": "space.next",

    "cmd-q": "app.quit",
    "cmd-h": "app.hide",
    "cmd-alt-h": "app.hide_others"
